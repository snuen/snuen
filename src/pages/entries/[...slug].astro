---
import { getCollection, render } from "astro:content";
import { execSync } from "child_process";
import { statSync } from "fs";
import { resolve } from "path";
import BaseLayout from "../../layouts/BaseLayout.astro";

function getGitUpdatedAt(filePath: string, fallback: Date): Date {
  try {
    const result = execSync(`git log -1 --format="%ci" -- "${filePath}"`)
      .toString()
      .trim();
    return result ? new Date(result) : fallback;
  } catch {
    return fallback;
  }
}

export async function getStaticPaths() {
  const entries = await getCollection("entries", ({ data }) => data.published);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const mdxPath = resolve(`content/entries/${entry.id}.mdx`);
const mdPath = resolve(`content/entries/${entry.id}.md`);
const entryFilePath = (() => {
  try {
    statSync(mdxPath);
    return mdxPath;
  } catch {
    return mdPath;
  }
})();
const updatedAt = getGitUpdatedAt(entryFilePath, entry.data.date);

const sources = entry.data.sources ?? [];
const primarySource = sources.length === 1 ? sources[0] : null;

const description =
  sources.length === 1 && sources[0].book_title
    ? `${sources[0].book_title}${sources[0].author ? ` — ${sources[0].author}` : ""} の読書記録。`
    : sources.length > 1
      ? sources
          .map((s) => s.book_title)
          .filter(Boolean)
          .join("、") + " などを参照した記録。"
      : `${entry.data.title} の記録。`;
---

<BaseLayout title={entry.data.title} description={description}>
  <a href="/" class="back-link">
    <span class="back-arrow">←</span>
    一覧に戻る
  </a>

  <header class="entry-header">
    <p class="entry-kicker">entry</p>
    <h1>{entry.data.title}</h1>
    <div class="entry-header-meta">
      {
        primarySource?.book_title && (
          <span
            class="entry-book-title meta-stamp meta-stamp--faint"
            data-prefix="書"
          >
            {primarySource.book_title}
          </span>
        )
      }
      {
        primarySource?.author && (
          <span
            class="entry-author meta-stamp meta-stamp--muted"
            data-prefix="著"
          >
            {primarySource.author}
          </span>
        )
      }
      <time
        class="entry-date meta-stamp meta-stamp--accent"
        data-prefix="作成"
        datetime={entry.data.date.toISOString()}
      >
        {entry.data.date.toLocaleDateString("ja-JP")}
      </time>
      <time
        class="entry-updated meta-stamp meta-stamp--faint"
        data-prefix="更新"
        datetime={updatedAt.toISOString()}
      >
        {updatedAt.toLocaleDateString("ja-JP")}
      </time>
    </div>
  </header>

  {/* 単一ソース — カバー表示（従来と同じ） */}
  {
    primarySource?.cover && primarySource?.amazon_url && (
      <a
        href={primarySource.amazon_url}
        class="entry-cover-link"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          src={primarySource.cover}
          alt={primarySource.book_title ?? entry.data.title}
          class="entry-cover"
        />
      </a>
    )
  }
  {
    primarySource?.cover && !primarySource?.amazon_url && (
      <img
        src={primarySource.cover}
        alt={primarySource.book_title ?? entry.data.title}
        class="entry-cover"
      />
    )
  }

  {/* 複数ソース — ソース一覧ブロック */}
  {
    sources.length > 1 && (
      <div class="entry-sources">
        <p class="entry-sources-label">参照した資料</p>
        <ul class="entry-sources-list">
          {sources.map((source) => (
            <li class="entry-source-item">
              {source.cover && source.amazon_url && (
                <a
                  href={source.amazon_url}
                  class="entry-source-cover-link"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <img
                    src={source.cover}
                    alt={source.book_title}
                    class="entry-source-cover"
                  />
                </a>
              )}
              {source.cover && !source.amazon_url && (
                <img
                  src={source.cover}
                  alt={source.book_title}
                  class="entry-source-cover"
                />
              )}
              <div class="entry-source-info">
                {source.book_title && (
                  <span class="meta-stamp meta-stamp--faint" data-prefix="書">
                    {source.book_title}
                  </span>
                )}
                {source.author && (
                  <span class="meta-stamp meta-stamp--faint" data-prefix="著">
                    {source.author}
                  </span>
                )}
                {source.url && (
                  <a
                    href={source.url}
                    class="entry-source-url-link"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {source.url}
                  </a>
                )}
              </div>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  <article class="prose">
    {
      primarySource?.url && (
        <p class="entry-source-url">
          <a href={primarySource.url} target="_blank" rel="noopener noreferrer">
            {primarySource.url}
          </a>
        </p>
      )
    }
    <Content />
  </article>

  <p class="entry-colophon" aria-label="記録の終わり">
    <span class="colophon-rule" aria-hidden="true"></span>
    <span class="colophon-text">記録の終わり</span>
    <span class="colophon-rule" aria-hidden="true"></span>
  </p>

  <a href="/" class="back-link back-link--bottom">
    <span class="back-arrow">←</span>
    一覧に戻る
  </a>
</BaseLayout>
